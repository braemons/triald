# Generated by protoc into a scratch tree by `make check-proto`.
/build/proto-check

# The panels' build step. `client/web/` is an npm project as well as a web
# root: node_modules is somebody else's source, and gen/ is regenerated from
# proto/ by `make web`. What is committed is the one bundle they produce,
# client/web/elements/daemon_api_client.js.
/client/web/node_modules/
/client/web/gen/
/build/web-check.js

# The Python client is its own uv project beside the daemon's.
/client/python/.venv/
/client/python/dist/
/client/python/build/
