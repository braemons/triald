# Normalise to LF in the repository. Checkouts on Windows may use CRLF, but the
# files below must stay LF in the working tree too: a .service unit or a shell
# script with CRLF line endings fails on Linux in ways that are tedious to
# diagnose ("bad interpreter: /bin/sh^M").
* text=auto

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf
packaging/logrotate/*  text eol=lf
packaging/scripts/*    text eol=lf

*.py        text
*.md        text
uv.lock     text -diff
